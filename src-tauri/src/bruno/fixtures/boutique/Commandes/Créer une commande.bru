meta {
  name: Créer une commande
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders?source=web
  body: json
  auth: inherit
}

params:query {
  source: web
  ~debug: true
}

headers {
  content-type: application/json
  x-request-id: {{$randomUUID}}
}

body:json {
  {
    "customer": "{{customerId}}",
    "items": [
      { "sku": "A-1", "price": 12.5, "qty": 2 }
    ],
    "createdAt": "{{$isoTimestamp}}"
  }
}

vars:pre-request {
  customerId: 42
}

vars:post-response {
  orderId: res.body.id
  ~oldId: res.body.legacyId
}

assert {
  res.status: eq 201
  res.body.status: eq "pending"
  res.body.id: isDefined
  res.body.total: gt 0
  res.headers["content-type"]: contains json
  res.body.reference: matches ^CMD-[0-9]+$
}

tests {
  test("total cohérent", function () {
    const o = res.getBody();
    const sum = o.items.reduce(
      (s, i) => s + i.price * i.qty, 0);
    expect(o.total).to.equal(sum);
  });
}

docs {
  Crée une commande pour le client `customerId`.
}

settings {
  encodeUrl: true
  timeout: 5000
}
